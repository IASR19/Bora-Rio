# Copie este arquivo para ".env" antes de rodar o projeto.
VITE_API_BASE_URL=http://localhost:3000/api

# Login com Google — mesmo Client ID (tipo "Web application") cadastrado no
# backend (GOOGLE_CLIENT_ID). Sem isso, o botão aparece desabilitado.
VITE_GOOGLE_CLIENT_ID=

# Feature flags
# Em teste, mude para "false" para pular a confirmação de número por SMS no cadastro.
VITE_FEATURE_PHONE_VERIFICATION=true
# "Continuar com Apple" ainda não está implementado — deixe "false" até integrar.
VITE_FEATURE_APPLE_LOGIN=false
