# Copie este arquivo para ".env" antes de rodar o projeto.

# Banco de dados
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=bora
DATABASE_PASSWORD=bora1234
DATABASE_NAME=bora-rio-dev

# JWT
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CHECKIN_QR_SECRET=change-me-checkin-secret

# Aplicacao
NODE_ENV=development
PORT=3000
API_PREFIX=api
SWAGGER_ENABLED=true

# CORS
CORS_ALLOWLIST=http://localhost:5173,http://localhost:4173
