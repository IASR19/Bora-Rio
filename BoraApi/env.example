# Copie este arquivo para ".env" antes de rodar o projeto.

# Banco de dados
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=bora
DATABASE_PASSWORD=bora1234
DATABASE_NAME=bora-rio-dev
# "true" em produção quando o Postgres hospedado exige SSL (Neon, Supabase, Railway Postgres, etc.)
DATABASE_SSL=false
DATABASE_POOL_MAX=5

# JWT
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=10d
CHECKIN_QR_SECRET=change-me-checkin-secret

# Login com Google — mesmo Client ID (tipo "Web application") usado no front
# (VITE_GOOGLE_CLIENT_ID). Crie em https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Aplicacao
NODE_ENV=development
PORT=3000
API_PREFIX=api
SWAGGER_ENABLED=true

# CORS — opcional em produção: front e API ficam no mesmo domínio Vercel (same-origin).
# Só é necessário se algo chamar a API de outra origem.
CORS_ALLOWLIST=http://localhost:5173,http://localhost:4173

# Validação de ponto comercial: o contrato social é analisado pela OpenAI contra o CNPJ
# (consulta pública na BrasilAPI). Sem chave, toda validação vai pra revisão manual
# (npm run business:review). Chave em https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
